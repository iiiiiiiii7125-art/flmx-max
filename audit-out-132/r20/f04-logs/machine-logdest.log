# /etc/systemd/system/flux_agent.service
[Unit]
Description=Flux_agent Proxy Service
After=network.target

[Service]
WorkingDirectory=/etc/flux_agent
ExecStart=/etc/flux_agent/flux_agent
Environment=GODEBUG=disablethp=1
Restart=on-failure
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
