#!/usr/bin/env python3
"""R20-L2: panel API helper (fresh implementation).

Reads credentials from a cred file (panel_url/backend/username/password
lines), logs in once, and performs one API call per invocation.

Usage:
  r20_l2_api.py <cred_file> <method> <path> [json_body] [outfile]
Examples:
  r20_l2_api.py /root/r20/cred.txt GET /api/v1/node/list
  r20_l2_api.py /root/r20/cred.txt POST /api/v1/inbound/create '{"nodeId":1,...}'
The raw JWT is never printed; only the HTTP status and the panel's
{code,msg} are echoed. Response bodies are written to outfile (or
stdout) for the caller to archive.
"""
import json
import sys
import urllib.request

cred_file, method, path = sys.argv[1], sys.argv[2], sys.argv[3]
body = sys.argv[4] if len(sys.argv) > 4 else None
outfile = sys.argv[5] if len(sys.argv) > 5 else None

creds = {}
for line in open(cred_file):
    if ":" in line:
        k, v = line.split(":", 1)
        creds[k.strip()] = v.strip()
base = creds["panel_url"].rstrip("/")


def call(path, payload=None, token=None, http_method=None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(base + path, data=data,
                                 method=http_method or ("POST" if payload is not None else "GET"))
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", token)
    with urllib.request.urlopen(req, timeout=60) as resp:
        return resp.status, resp.read().decode()


# Login: POST /api/v1/user/login {username, password} -> data.token.
# The panel rate-limits logins (429), so cache the token next to this
# script (0600) and reuse it while fresh.
import os
import time

token_cache = os.path.join(os.path.dirname(os.path.abspath(cred_file)), ".token")
token = None
if os.path.exists(token_cache) and time.time() - os.path.getmtime(token_cache) < 1200:
    with open(token_cache) as f:
        token = f.read().strip()
if not token:
    status, text = call("/api/v1/user/login", {"username": creds["username"], "password": creds["password"]})
    login = json.loads(text)
    if login.get("code") != 0:
        print(f"LOGIN FAILED http={status} code={login.get('code')} msg={login.get('msg')}", file=sys.stderr)
        sys.exit(1)
    token = login["data"]["token"]
    with open(token_cache, "w") as f:
        f.write(token)
    os.chmod(token_cache, 0o600)

status, text = call(path, json.loads(body) if body else None, token, http_method=method)
try:
    parsed = json.loads(text)
    print(f"http={status} code={parsed.get('code')} msg={parsed.get('msg')}")
except Exception:
    print(f"http={status} (non-JSON body, {len(text)} bytes)")
if outfile:
    with open(outfile, "w") as f:
        f.write(text)
else:
    sys.stdout.write(text + "\n")
