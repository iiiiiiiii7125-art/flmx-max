#!/bin/bash
# R19-L5 deploy: main@d66042c bits (agent + paneld built in sandbox from the
# read-only tree; frontend dist reused from /root/r17d/stage/dist — see note)
# onto the Lightsail test machine. Adapted from R17-FIX-D-deploy.sh.
# NOTE on frontend dist reuse: `git diff 5473377..d66042c -- vite-frontend`
# is EMPTY and `git diff 5125ff5..d66042c -- vite-frontend` is EMPTY, i.e.
# the d66042c frontend source is byte-identical to the fix-r17 source the
# r17d dist was built from (same pnpm-lock.yaml). The dist is therefore a
# build of identical source; no pnpm toolchain exists in the sandbox to
# rebuild it. The dist index.html sha + 59-asset count are verified at
# deploy time against the R17-L5 served-chunk baseline (58 JS + 1 CSS).
# Run on the test machine as root; log to /root/r19/R19-L5-deploy.log
# (caller tees ssh output to the local audit log of the same name).
# Usage: bash R19-L5-deploy.sh [full|panel]
#   full  = panel + r19d agent (default)
#   panel = panel only; agent binary untouched (for Phase A/B kill-freeze
#           on the un-fixed agent, where the sent-ok signal comes from the
#           r19d backend's guard dispatch record). The journal unit is
#           installed in both modes (restored to null unit at restore).
# Order: stop agent -> backup pristine agent -> install r19d agent +
# journal unit -> unpack stage -> docker build backend/frontend ->
# switch compose tags -> compose up -> reset-failed + start agent -> served.
set -u
MODE="${1:-full}"
R=/root/r19
echo "=== R19-L5 deploy mode=$MODE $(date -u +%FT%TZ) initiator=L5 ==="
echo "--- pre-state"
df -h / | tail -1
grep FLUX_VERSION /root/flmx-panel/.env
systemctl is-active flux_agent
md5sum /etc/flux_agent/gost.json /etc/flux_agent/flux_agent
wc -l /etc/flux_agent/gost.json
echo "--- stop agent (initiator=L5, deploy r19d)"
systemctl stop flux_agent; sleep 3
pgrep -af '/etc/flux_agent/flux_agent' || echo "agent processes gone"
echo "--- backup pristine agent (expect aff338e3676bc56d0f3986a1a62f8fdd)"
cp /etc/flux_agent/flux_agent $R/flux_agent.pristine
md5sum /etc/flux_agent/flux_agent $R/flux_agent.pristine
echo "--- install r19d agent (md5 recorded in local build log)"
